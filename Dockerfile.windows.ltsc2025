# Download harness-har
FROM mcr.microsoft.com/windows/servercore:ltsc2025 AS hc-downloader

WORKDIR C:/hc

# HC_VERSION is the single source of truth for the pinned harness-har version.
COPY HC_VERSION .
RUN powershell -Command "$ver = (Get-Content HC_VERSION).Trim(); Invoke-WebRequest -Uri ('https://github.com/harness/cli/releases/download/har/v' + $ver + '/harness-plugin-har_' + $ver + '_windows_amd64.zip') -OutFile 'harness-har_windows_amd64.zip'"

# Build har.exe
FROM golang:1.24-windowsservercore-ltsc2025 AS builder

WORKDIR C:/app
COPY go.mod go.sum ./
RUN go mod download

COPY . .
# The plugin embeds harness-har, so the archive has to be in place before the
# build. The exe that comes out needs no harness-har on disk or at runtime.
COPY --from=hc-downloader C:/hc/harness-har_windows_amd64.zip C:/app/plugin/packages/hcbin/
RUN go build -o drone-har.exe .

# Final runtime image
FROM mcr.microsoft.com/windows/servercore:ltsc2025

WORKDIR C:/bin
COPY --from=builder C:/app/drone-har.exe C:/bin/har.exe

ENV PATH="C:\\bin;${PATH}"

ENTRYPOINT ["C:\\bin\\har.exe"]
